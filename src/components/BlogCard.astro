---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  category: string;
  readTime: string;
  slug: string;
}

const { title, description, pubDate, author, category, readTime, slug } = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class="blog-card reveal-on-scroll">
  <div class="card-meta">
    <span class="badge">{category}</span>
    <span class="meta-time">{readTime} read</span>
  </div>

  <h3 class="card-title">
    <a href={`/blog/${slug}`}>{title}</a>
  </h3>

  <p class="card-desc">{description}</p>

  <div class="card-footer">
    <div class="card-author">
      <div class="author-avatar">{author.charAt(0)}</div>
      <div class="author-info">
        <span class="author-name">{author}</span>
        <span class="pub-date">{formattedDate}</span>
      </div>
    </div>

    <a href={`/blog/${slug}`} class="read-cta" aria-label={`Read article: ${title}`}>
      Read Article
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</article>

<style>
  .blog-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.2s ease;
  }

  .blog-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .meta-time {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .card-title {
    font-size: var(--font-size-xl);
    line-height: 1.35;
    margin-bottom: var(--space-3);
  }

  .card-title a {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--color-primary);
  }

  .card-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    flex: 1;
    margin-bottom: var(--space-6);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    margin-top: auto;
  }

  .card-author {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .author-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 700;
    font-size: var(--font-size-xs);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .author-name {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .pub-date {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .read-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .read-cta:hover {
    transform: translateX(3px);
  }
</style>
