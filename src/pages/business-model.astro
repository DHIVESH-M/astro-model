---
import Layout from '../layouts/Layout.astro';
import BusinessCanvas from '../components/BusinessCanvas.astro';
import BusinessSummary from '../components/BusinessSummary.astro';
import Button from '../components/Button.astro';
---

<Layout 
  title="Business Model Canvas — Aegis H2O Project Strategy"
  description="Interactive 9-block Business Model Canvas and strategic evaluation matrix for the Aegis H2O water monitoring platform."
>
  <div class="page-header">
    <div class="container">
      <span class="section-eyebrow">STARTUP & PROJECT STRATEGY</span>
      <h1 class="page-title">Business Model Canvas</h1>
      <p class="page-desc">
        A structured breakdown of key partners, core activities, value propositions, target segments, cost structure, and future commercialization opportunities for Aegis H2O.
      </p>
    </div>
  </div>

  <!-- SECTION 1: BUSINESS MODEL CANVAS GRID -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">9-BLOCK CANVAS</span>
        <h2 class="section-title">Strategic Architecture</h2>
        <p class="section-subtitle">
          Hover over or inspect each block to explore proposed partnerships, active engineering activities, value drivers, and target channels.
        </p>
      </div>

      <BusinessCanvas />
    </div>
  </section>

  <!-- SECTION 2: SUMMARY & EVALUATION MATRIX -->
  <section class="section bg-surface">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">PROJECT EVALUATION</span>
        <h2 class="section-title">Business & Validation Context</h2>
        <p class="section-subtitle">
          Distinguishing current prototype capabilities from future market hypotheses and scientific validation requirements.
        </p>
      </div>

      <BusinessSummary />

      <div class="canvas-back-bar">
        <Button href="/research" variant="primary" size="lg">
          Explore Research & Methodology
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </Button>
        <Button href="/" variant="secondary" size="lg">
          Return to Home Page
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3rem);
    margin-bottom: var(--space-3);
  }

  .page-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 720px;
  }

  .canvas-back-bar {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: var(--space-12);
  }
</style>
