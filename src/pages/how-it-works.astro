---
import Layout from '../layouts/Layout.astro';
import SystemWorkflow from '../components/SystemWorkflow.astro';

const stepsDetail = [
  {
    stepNum: '01',
    title: 'Water Input & Fluidic Sampling',
    subtitle: 'Controlled Sample Ingestion',
    desc: 'Fluid enters through a dedicated flow chamber designed to eliminate air bubbles and stabilize pressure gradients across measuring probes.',
    techDetails: [
      'Constant hydrostatic head manifold design',
      'Anti-turbulence fluidic baffle channels',
      'In-line mechanical debris strainer (Mesh 100)'
    ],
    icon: 'droplet'
  },
  {
    stepNum: '02',
    title: 'Sensor Data Collection',
    subtitle: 'Multi-Probe Signal Acquisition',
    desc: 'Continuous analog voltage and pulse signals are generated by electrochemical (pH, TDS) and optical (turbidity, photodiode) sensor arrays.',
    techDetails: [
      'Glass electrode pH probe with Op-Amp amplification',
      'AC-driven TDS conductivity sensor eliminating electrode polarization',
      '90° / 180° near-IR scattering optical turbidity probe'
    ],
    icon: 'activity'
  },
  {
    stepNum: '03',
    title: 'Microcontroller Processing',
    subtitle: 'ESP32 Edge Signal Conditioning',
    desc: 'The dual-core ESP32 microcontroller executes 12-bit SAR ADC conversions, applies polynomial calibration curves, and formats raw JSON payloads.',
    techDetails: [
      '240 MHz Xtensa LX6 dual-core processor',
      '12-bit ADC sampling with attenuation correction',
      'Temperature compensation using DS18B20 digital thermal probe'
    ],
    icon: 'cpu'
  },
  {
    stepNum: '04',
    title: 'Data Validation & Denoising',
    subtitle: 'Signal Integrity & Bounds Check',
    desc: 'Raw sensor readings undergo digital filtering (Kalman filter / moving average) and physical boundary checks to remove transient electrical spikes.',
    techDetails: [
      'Outlier elimination based on rolling standard deviation thresholds',
      'Stuck-at sensor fault identification',
      'Kalman filter noise reduction'
    ],
    icon: 'check-circle'
  },
  {
    stepNum: '05',
    title: 'Machine Learning Classification',
    subtitle: 'Multi-Parameter Anomaly Scoring',
    desc: 'Pre-processed sensor vectors are passed to machine learning classification models to evaluate parameter relationships and detect anomalies.',
    techDetails: [
      'Random Forest & Support Vector Machine (SVM) ensemble models',
      'Multi-feature vector input: [pH, TDS, NTU, Flow, d(pH)/dt]',
      'Probability confidence score output'
    ],
    icon: 'layers'
  },
  {
    stepNum: '06',
    title: 'Backend Communication API',
    subtitle: 'Encrypted Telemetry Streaming',
    desc: 'Validated telemetry payloads are transmitted over secure HTTPS REST endpoints and WebSocket channels for persistent storage and streaming.',
    techDetails: [
      'RESTful ingestion API endpoint with TLS encryption',
      'Low-latency WebSocket event pub/sub server',
      'Time-series data storage with structured schema'
    ],
    icon: 'cloud'
  },
  {
    stepNum: '07',
    title: 'Dashboard & Real-Time Monitoring',
    subtitle: 'Interactive Visual Analytics',
    desc: 'Researchers and users inspect live metric gauges, historical parameter graphs, system health diagnostics, and anomaly warnings on the web app.',
    techDetails: [
      'Real-time metric gauge and time-series chart components',
      'Configurable anomaly alert thresholds',
      'CSV dataset export for scientific review'
    ],
    icon: 'layout'
  }
];
---

<Layout 
  title="How It Works — Aegis H2O System Workflow"
  description="Detailed step-by-step breakdown of the hardware, sensor signal conditioning, ESP32 edge processing, and ML workflow powering Aegis H2O."
>
  <div class="page-header">
    <div class="container">
      <span class="section-eyebrow">SYSTEM ARCHITECTURE</span>
      <h1 class="page-title">How Aegis H2O Works</h1>
      <p class="page-desc">
        A step-by-step technical breakdown of fluid acquisition, signal processing, edge microcontrollers, data validation, and machine learning analytics.
      </p>
    </div>
  </div>

  <!-- OVERVIEW DIAGRAM SECTION -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">WORKFLOW OVERVIEW</span>
        <h2 class="section-title">End-to-End System Pipeline</h2>
        <p class="section-subtitle">
          Interactive view of data movement across all seven core architectural phases.
        </p>
      </div>

      <SystemWorkflow />
    </div>
  </section>

  <!-- DETAILED STEPS SECTION -->
  <section class="section bg-surface">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">TECHNICAL DEEP DIVE</span>
        <h2 class="section-title">Detailed Pipeline Specifications</h2>
        <p class="section-subtitle">
          In-depth technical specifications for every stage in the Aegis H2O engineering workflow.
        </p>
      </div>

      <div class="steps-detail-list">
        {stepsDetail.map((step) => (
          <div class="step-detail-card reveal-on-scroll">
            <div class="step-number-box">{step.stepNum}</div>
            
            <div class="step-main-content">
              <span class="step-sub">{step.subtitle}</span>
              <h3 class="step-main-title">{step.title}</h3>
              <p class="step-main-desc">{step.desc}</p>
              
              <div class="step-tech-box">
                <span class="tech-box-label">Technical Implementation Details:</span>
                <ul class="tech-box-list">
                  {step.techDetails.map((detail) => (
                    <li>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                      <span>{detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3rem);
    margin-bottom: var(--space-3);
  }

  .page-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 700px;
  }

  .steps-detail-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .step-detail-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  @media (min-width: 768px) {
    .step-detail-card {
      grid-template-columns: 80px 1fr;
      gap: 2rem;
    }
  }

  .step-detail-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .step-number-box {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: var(--font-size-2xl);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-sub {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-teal);
    display: block;
    margin-bottom: 0.25rem;
  }

  .step-main-title {
    font-size: var(--font-size-2xl);
    margin-bottom: 0.75rem;
  }

  .step-main-desc {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .step-tech-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }

  .tech-box-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .tech-box-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .tech-box-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .tech-box-list svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }
</style>
