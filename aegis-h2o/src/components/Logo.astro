---
interface Props {
  size?: number;
  showText?: boolean;
}

const { size = 32, showText = true } = Astro.props;
---

<a href="/" class="brand-logo" aria-label="Aegis H2O Home">
  <div class="logo-icon" style={`width: ${size}px; height: ${size}px;`}>
    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="logo-svg">
      <!-- Shield Outer Protection Outline -->
      <path d="M20 3L32 8V18C32 26.5 26.8 33.8 20 37C13.2 33.8 8 26.5 8 18V8L20 3Z" 
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shield-path"/>
      <!-- Internal Water Drop & Flow Geometry -->
      <path d="M20 12C20 12 14 19 14 23C14 26.3137 16.6863 29 20 29C23.3137 29 26 26.3137 26 23C26 19 20 12 20 12Z" 
            fill="url(#waterGrad)" class="drop-path"/>
      <!-- Wave Accent -->
      <path d="M16 23.5C18 22.5 22 25 24 23.5" 
            stroke="white" stroke-width="1.8" stroke-linecap="round"/>
      <defs>
        <linearGradient id="waterGrad" x1="14" y1="12" x2="26" y2="29" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#0284C7"/>
          <stop offset="100%" stop-color="#00A896"/>
        </linearGradient>
      </defs>
    </svg>
  </div>
  {showText && (
    <div class="logo-text">
      <span class="brand-name">AEGIS <span class="brand-h2o">H2O</span></span>
      <span class="brand-sub">Rathinam Global</span>
    </div>
  )}
</a>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .logo-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .shield-path {
    transition: stroke 0.2s ease;
  }

  .brand-logo:hover .shield-path {
    stroke: var(--color-accent-teal);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }

  .brand-h2o {
    color: var(--color-primary);
  }

  .brand-sub {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }
</style>
