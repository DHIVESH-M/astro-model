---
interface Props {
  title: string;
  category: string;
  description: string;
  specs?: string;
  iconName: 'esp32' | 'ph' | 'tds' | 'flow' | 'turbidity' | 'photodiode' | 'ml' | 'api';
}

const { title, category, description, specs, iconName } = Astro.props;
---

<div class="tech-card reveal-on-scroll">
  <div class="tech-card-header">
    <div class="tech-icon-box">
      {iconName === 'esp32' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/></svg>
      )}
      {iconName === 'ph' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
      )}
      {iconName === 'tds' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      )}
      {iconName === 'flow' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
      )}
      {iconName === 'turbidity' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"/><path d="M20 12v8H4v-8"/><path d="m6 8 6-4 6 4"/></svg>
      )}
      {iconName === 'photodiode' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2"/><path d="M12 21v2"/><path d="M4.22 4.22l1.42 1.42"/><path d="M18.36 18.36l1.42 1.42"/><path d="M1 12h2"/><path d="M21 12h2"/><path d="M4.22 19.78l1.42-1.42"/><path d="M18.36 5.64l1.42-1.42"/></svg>
      )}
      {iconName === 'ml' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/><path d="M12 12L2.1 10a10 10 0 0 1 17.8-5.3L12 12z"/></svg>
      )}
      {iconName === 'api' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
      )}
    </div>
    <span class="badge tech-badge">{category}</span>
  </div>

  <h3 class="tech-title">{title}</h3>
  <p class="tech-desc">{description}</p>
  
  {specs && (
    <div class="tech-specs">
      <span class="specs-label">Technical Specification:</span>
      <code class="specs-code">{specs}</code>
    </div>
  )}
</div>

<style>
  .tech-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
  }

  .tech-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .tech-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .tech-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tech-title {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2);
  }

  .tech-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .tech-specs {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .specs-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .specs-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
    background-color: var(--color-surface);
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
    width: fit-content;
  }
</style>
