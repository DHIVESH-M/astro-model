---
interface Props {
  name: string;
  role: string;
  responsibilities: string;
  contribution: string;
  githubUrl?: string;
  initials?: string;
}

const { name, role, responsibilities, contribution, githubUrl, initials } = Astro.props;

const memberInitials = initials || name.split(' ').map(n => n[0]).join('');
---

<div class="team-card reveal-on-scroll">
  <div class="team-header">
    <div class="team-avatar">{memberInitials}</div>
    <div class="team-meta">
      <h3 class="team-name">{name}</h3>
      <span class="badge role-badge">{role}</span>
    </div>
  </div>

  <div class="team-body">
    <div class="team-section">
      <span class="section-label">Core Responsibilities</span>
      <p class="section-text">{responsibilities}</p>
    </div>

    <div class="team-section">
      <span class="section-label">Research Contribution</span>
      <p class="section-text">{contribution}</p>
    </div>
  </div>

  {githubUrl && (
    <div class="team-footer">
      <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="team-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        GitHub Profile
      </a>
    </div>
  )}
</div>

<style>
  .team-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.2s ease;
  }

  .team-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .team-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: var(--space-4);
  }

  .team-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 800;
    font-size: var(--font-size-base);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-border);
    flex-shrink: 0;
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .team-name {
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .role-badge {
    align-self: flex-start;
  }

  .team-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .team-section {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .section-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .team-footer {
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border);
  }

  .team-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .team-link:hover {
    color: var(--color-primary);
  }
</style>
