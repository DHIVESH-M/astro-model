---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Related articles
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug)
  .slice(0, 2);
---

<Layout 
  title={`${post.data.title} — Aegis H2O Research`}
  description={post.data.description}
>
  <div class="article-header">
    <div class="container container-reading">
      <a href="/blog" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Back to Research Blog
      </a>

      <div class="article-meta-top">
        <span class="badge">{post.data.category}</span>
        <span class="meta-item">{post.data.readTime} read</span>
        <span class="meta-item">{formattedDate}</span>
      </div>

      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-lead">{post.data.description}</p>

      <div class="author-bar">
        <div class="author-avatar">{post.data.author.charAt(0)}</div>
        <div class="author-details">
          <span class="author-name">{post.data.author}</span>
          <span class="author-affiliation">Rathinam Global Deemed-to-be University</span>
        </div>
      </div>
    </div>
  </div>

  <article class="article-body">
    <div class="container container-reading prose">
      <Content />
    </div>
  </article>

  <!-- RELATED ARTICLES -->
  {relatedPosts.length > 0 && (
    <section class="section related-section">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">CONTINUE READING</span>
          <h2 class="section-title">Related Research Articles</h2>
        </div>

        <div class="related-grid">
          {relatedPosts.map(rel => (
            <BlogCard
              title={rel.data.title}
              description={rel.data.description}
              pubDate={rel.data.pubDate}
              author={rel.data.author}
              category={rel.data.category}
              readTime={rel.data.readTime}
              slug={rel.slug}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .article-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
  }

  .container-reading {
    max-width: var(--max-width-content);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: var(--space-4);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .article-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.25;
    margin-bottom: var(--space-4);
  }

  .article-lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .author-bar {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: 800;
    font-size: var(--font-size-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .author-name {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .author-affiliation {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .article-body {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  /* Prose Styling */
  .prose {
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    line-height: 1.75;
  }

  .prose :global(h2) {
    font-size: var(--font-size-2xl);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .prose :global(h3) {
    font-size: var(--font-size-xl);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
    color: #334155;
  }

  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: #334155;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-secondary);
    background-color: var(--color-surface);
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .prose :global(pre) {
    background-color: #0F172A;
    color: #F8FAFC;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    margin: 1.5rem 0;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--color-surface);
    color: var(--color-primary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .prose :global(pre code) {
    background-color: transparent;
    color: inherit;
    padding: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: var(--font-size-sm);
  }

  .prose :global(th) {
    background-color: var(--color-surface);
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--color-border);
    text-align: left;
  }

  .prose :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .related-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
</style>
